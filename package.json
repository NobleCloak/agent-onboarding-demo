{
  "name": "fernhill-desk",
  "version": "0.0.0",
  "private": true,
  "description": "Fernhill Desk: a fake internal ops app that shows NobleCloak governing a scripted agent. The agent and tools are fake. The adapter, the approval flow and the Permissions module are the published NobleCloak packages, run against a local mock with a small demo shim that makes saved rules decide outcomes.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "next dev -p 3417 -H 127.0.0.1",
    "build": "next build",
    "start": "FERNHILL_RUN_MODE=mock next start -p 3417 -H 127.0.0.1",
    "dev:deployment": "NEXT_PUBLIC_FERNHILL_MODE=deployment next dev -p 3417 -H localhost",
    "build:deployment": "NEXT_PUBLIC_FERNHILL_MODE=deployment next build",
    "start:deployment": "FERNHILL_RUN_MODE=deployment next start -p 3417 -H localhost",
    "test": "vitest run",
    "e2e": "playwright test",
    "noblecloak": "bun scripts/noblecloak-local.ts",
    "demo": "bun scripts/demo.ts",
    "demo:deployment": "NEXT_PUBLIC_FERNHILL_MODE=deployment bun scripts/demo.ts",
    "demo:new": "bun scripts/demo-new.ts",
    "reset": "bun scripts/reset-run.ts",
    "reset:full": "bun scripts/reset-full.ts",
    "preflight": "bun scripts/preflight.ts",
    "preflight:deployment": "NEXT_PUBLIC_FERNHILL_MODE=deployment bun scripts/preflight.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/noblecloak/worker.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@noblecloak/client": "0.14.1",
    "@noblecloak/langgraph": "0.5.2",
    "@noblecloak/react": "0.10.2",
    "@noblecloak/theme": "0.1.3",
    "better-sqlite3": "12.11.1",
    "langchain": "1.5.19",
    "lucide-react": "1.66.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@noblecloak/spec": "0.12.3",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
